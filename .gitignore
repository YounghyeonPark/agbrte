# Scratch workspace the CLI driver writes into during live runs. Contains a real
# `.agbrte` session store — derived state, never source.
sandbox/

# Build output (esbuild → dist/main, vite → dist/renderer)
dist/

# Playwright run artifacts (traces, screenshots, last-run state)
test-results/
playwright-report/

# Scratch workspaces from manual runs. Named this way because a stray one got
# committed once: they contain .agbrte/ with real session logs.
tmp-*/

# electron-builder output. Installers are ~130-190 MB each and are produced by
# `npm run dist`; a release is an artifact, never a commit.
release/

# Screenshots written by tests/e2e/shots.spec.ts, for looking at the UI.
.shots/

# electron-builder output.
release/

# PowerShell's own module cache, which it writes here rather than under
# %LOCALAPPDATA% when a child process cannot resolve that variable. Not ours,
# never useful, and it has been swept into `git add -A` twice. Ignored rather
# than explained: three runs of the suite failed to reproduce it and the cause
# is still unknown, so this stops it being committed and nothing more.
Microsoft/
