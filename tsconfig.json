{
  "// note": "Node-side code: main process, preload, shared types, tests. No DOM lib on purpose.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  // `tests/rendererStore.test.ts` and `tests/attachDiscovery.test.ts` are
  // renderer code and belong to the web project: importing the store here would
  // drag `window` into a project whose lib is deliberately Node-only.
  "exclude": ["tests/rendererStore.test.ts", "tests/attachDiscovery.test.ts"],
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/web/server.ts",
    "src/shared/**/*.ts",
    "src/cli/**/*.ts",
    "src/smoke/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
