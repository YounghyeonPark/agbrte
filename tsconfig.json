{
  "// note": "Node-side code: main process, preload, shared types, tests. No DOM lib on purpose.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/cli/**/*.ts",
    "src/smoke/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
