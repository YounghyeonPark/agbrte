{
  "name": "loom",
  "version": "0.0.1",
  "private": true,
  "description": "Agent-based development workbench",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "build": "node scripts/build.mjs && vite build",
    "smoke": "node scripts/build.mjs --smoke && vite build && node scripts/smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "loom": "tsx src/cli/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  }
}
