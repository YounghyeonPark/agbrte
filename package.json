{
  "name": "agbrte",
  "version": "0.0.31",
  "description": "Agent Bridge Terminal — durable, bridge-owned agent sessions you attach to from any terminal.",
  "license": "Apache-2.0",
  "author": "Younghyeon Park <ypark.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YounghyeonPark/agbrte.git"
  },
  "homepage": "https://github.com/YounghyeonPark/agbrte",
  "bugs": {
    "url": "https://github.com/YounghyeonPark/agbrte/issues"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "bin": {
    "agbrte": "dist/cli/agbrte.js"
  },
  "files": [
    "dist/cli",
    "dist/main",
    "dist/renderer",
    "dist/web",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "lint:classes": "npm run build && node scripts/inert-classes.mjs --strict",
    "lint:reach": "node scripts/unreached.mjs --strict",
    "lint:race": "node scripts/await-race.mjs --strict",
    "citation": "node scripts/citation.mjs",
    "models": "node scripts/model-catalogue.mjs",
    "build": "node scripts/build.mjs && vite build",
    "smoke": "node scripts/build.mjs --smoke && vite build && node scripts/smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "e2e": "npm run build && playwright test",
    "agbrte:direct": "tsx src/cli/run.ts",
    "cli": "node scripts/build.mjs && node dist/cli/agbrte.js",
    "package": "node scripts/package.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@radix-ui/react-select": "^2.3.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "ws": "^8.21.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "electron@43.2.0": true
  }
}
